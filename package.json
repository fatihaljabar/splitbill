{
  "name": "splitbill",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "prebuild": "node scripts/copy-tesseract.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node server/index.ts",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@tailwindcss/vite": "^4.2.1",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.35.0",
    "hono": "^4.13.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.577.0",
    "lz-string": "^1.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
