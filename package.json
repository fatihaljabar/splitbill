{
  "name": "splitbill",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "db:generate": "drizzle-kit generate",
    "prebuild": "node scripts/copy-tesseract.mjs",
    "build": "vue-tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "preview": "vite preview",
    "test": "node --test shared/*.test.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@tailwindcss/vite": "^4.2.1",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "html-to-image": "^1.11.13",
    "lucide-vue-next": "^1.0.0",
    "lz-string": "^1.5.0",
    "mysql2": "^3.23.3",
    "qrcode.vue": "^3.10.0",
    "tailwindcss": "^4.2.1",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.3.9"
  }
}
