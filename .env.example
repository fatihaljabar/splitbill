# Salin ke .env, isi dengan kredensial sungguhan. Jangan pernah commit .env.
#
# Dev lokal: root MySQL lokal boleh, database ada di komputer sendiri saja.
# Production (Hostinger): WAJIB user terbatas, bukan root — database bersama
# yang menyimpan data pengguna sungguhan.
DATABASE_URL=mysql://pengguna:sandi@host:3306/nama_database

PORT=3000
